# Copy to .env (git-ignored) and fill in your values:
#   cp .env.example .env
# Then: ./build.sh   and   ./render.sh | kubectl apply -f -

# Google Cloud project hosting the cluster, Vertex AI, Artifact Registry, and telemetry.
PROJECT_ID=your-project-id

# Region for Vertex AI, the Artifact Registry repo, and the GKE cluster.
LOCATION=us-central1

# Artifact Registry Docker repository name (build.sh pushes here, deployment.yaml pulls from here).
AR_REPO=adk-demo

# GCS bucket (name only, no gs://) for multimodal prompt/response JSONL uploads.
BUCKET_NAME=your-bucket-name
