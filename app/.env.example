# Vertex AI access (required)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Optional: local OTLP/HTTP export to a collector on port 4318. ADK ships only
# the HTTP exporter and ignores OTEL_EXPORTER_OTLP_PROTOCOL. On GKE the
# Instrumentation CR injects these; leave them unset to skip export.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=adk-demo-agent
